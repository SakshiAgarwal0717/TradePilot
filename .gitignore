# ==============================================================================
# TradePilot Root .gitignore
# Comprehensive rules for Python, Node.js/Vite, Databases, Environments & Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Local Configurations & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example

# Private keys, certificates, secrets, and credentials
*.key
*.pem
*.pfx
*.cert
*.crt
*.secret
id_rsa*
*.p12

# ------------------------------------------------------------------------------
# 2. Local Database Files & SQLite Stores
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
tradepilot.db
test_tradepilot.db

# ------------------------------------------------------------------------------
# 3. Python Bytecode, Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Distribution & Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 4. Node.js, Frontend, Bundlers & Vite
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / Frontend Build Output
frontend/dist/
frontend/dist-ssr/
frontend/.oxlint-cache/

# Testing output
coverage/

# ------------------------------------------------------------------------------
# 5. Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors & IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak

# ------------------------------------------------------------------------------
# 6. Logs & Temporary Scratch Files
# ------------------------------------------------------------------------------
logs/
*.log
scratch/
tmp/
temp/
.vercel/
