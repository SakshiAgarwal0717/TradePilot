PROJECT_NAME=TradePilot
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./tradepilot.db

# PRODUCTION NOTE: Replace SECRET_KEY with a high-entropy secret (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-insecure-key-for-production-only-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME=tradepilot_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# AI Review Assistant Settings
# AI_PROVIDER_DEFAULT=openrouter  # Supported: openrouter, gemini
# OPENROUTER_API_KEY=your-openrouter-api-key-here
AI_PROVIDER_DEFAULT=openrouter
AI_MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# Google Gemini Settings (if AI_PROVIDER_DEFAULT=gemini)
# GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.0-flash

AI_REQUEST_TIMEOUT_SECONDS=30.0



